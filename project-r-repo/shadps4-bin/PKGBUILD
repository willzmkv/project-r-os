# Maintainer: zxp19821005 <zxp19821005 at 163 dot com>
pkgname=shadps4
_pkgname=shadPS4
pkgver=0.20.0
pkgrel=1
pkgdesc="Sony PlayStation 4 emulator."
arch=('x86_64')
url="https://shadps4.net/"
_ghurl="https://github.com/shadps4-emu/shadPS4"
license=('GPL-2.0-only')
provides=("${pkgname%-bin}=${pkgver}")
conflicts=("${pkgname%-bin}")
depends=(
    'util-linux-libs'
    'zlib-ng-compat'
    'alsa-lib'
)
source=(
    "${pkgname%-bin}-${pkgver}.zip::${_ghurl}/releases/download/v.${pkgver}/${pkgname%-bin}-linux-sdl-${pkgver}.zip"
)
sha256sums=('be25d0324cd7b74068d32cdb66fa1b7b1e7bb499b062be51c7006d27d41d4255')

prepare() {
    if [ -d "${srcdir}/squashfs-root" ]; then
        rm -rf "${srcdir}/squashfs-root"
    fi
    chmod +x "${srcdir}/Shadps4-sdl.AppImage"
    "${srcdir}/Shadps4-sdl.AppImage" --appimage-extract > /dev/null
    sed -i "s/net.${pkgname%-bin}.${_pkgname}/${pkgname%-bin}/g" \
        "${srcdir}/squashfs-root/usr/share/applications/net.${pkgname%-bin}.${_pkgname}.desktop"
}

package() {
    install -Dm755 -d "${pkgdir}/usr/lib/${pkgname%-bin}"
    cp -a "${srcdir}/squashfs-root/usr/"{bin,lib,optional} "${pkgdir}/usr/lib/${pkgname%-bin}"
    install -Dm644 "${srcdir}/squashfs-root/usr/share/icons/hicolor/scalable/apps/net.${pkgname%-bin}.${_pkgname}.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname%-bin}.svg"
    install -Dm644 "${srcdir}/squashfs-root/usr/share/applications/net.${pkgname%-bin}.${_pkgname}.desktop" \
        "${pkgdir}/usr/share/applications/${pkgname%-bin}.desktop"
    # Create launcher that sets LD_LIBRARY_PATH for extracted AppImage libs
    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${pkgname%-bin}" << 'EOF'
#!/usr/bin/env bash
HERE=/usr/lib/shadps4
export LD_LIBRARY_PATH="${HERE}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
exec "${HERE}/bin/shadps4" "$@"
EOF
}
