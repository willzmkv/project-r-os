# Maintainer: Project-R <https://github.com/willzmkv/project-r-os>
pkgname=pr-builder
pkgver=0.1.0
pkgrel=1
pkgdesc="Project-R — pr-builder (stub placeholder)"
arch=('x86_64')
license=('GPL3')
depends=()
source=()
sha256sums=()

package() {
    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/bash\necho "pr-builder stub"\n' > "$pkgdir/usr/bin/pr-builder"
    chmod +x "$pkgdir/usr/bin/pr-builder"

    install -dm755 "$pkgdir/usr/lib/systemd/system"
    cat > "$pkgdir/usr/lib/systemd/system/pr-builder.service" << 'SVCEOF'
[Unit]
Description=Project-R pr-builder (stub)
After=network.target

[Service]
ExecStart=/usr/bin/pr-builder
Restart=on-failure

[Install]
WantedBy=multi-user.target
SVCEOF
}
