# Maintainer:

pkgname=freeimage
pkgver=3.18.0
pkgrel=1
pkgdesc='Library for loading common image formats'
arch=('x86_64')
url='http://freeimage.sourceforge.net/'
license=('custom:FIPL' 'GPL2' 'GPL3')
depends=('gcc-libs')

_src="FreeImage${pkgver//./}"
source=(
  "${_src}.zip::https://downloads.sourceforge.net/freeimage/${_src}.zip"
)
sha256sums=('SKIP')

prepare() {
  cd FreeImage
  # GCC 14 treats 'register' as hard error in C++17; patch bundled OpenEXR/Half
  sed -i 's/\bregister int\b/int/g' Source/OpenEXR/Half/half.h
  # Append tolerant flags at end of Makefile (+=  preserves $(INCLUDE) etc.)
  printf '\nCFLAGS += -Wno-error -Wno-old-style-definition -Wno-implicit-function-declaration\n' >> Makefile.gnu
  printf 'CXXFLAGS += -std=gnu++14 -Wno-error\n' >> Makefile.gnu
}

build() {
  cd FreeImage
  make -f Makefile.gnu
  echo "=== FreeImage/ after make ===" >&2
  ls -la *.so* *.a 2>&1 || echo "no .so/.a in root" >&2
  echo "=== Dist/ ===" >&2
  ls -la Dist/ 2>&1 || echo "no Dist/" >&2
}

package() {
  cd FreeImage
  # .so is created in source root; Dist/ is only populated by 'make dist'
  install -Dm755 "libFreeImage.so.${pkgver}" \
    "${pkgdir}/usr/lib/libFreeImage.so.${pkgver}"
  ln -sf "libFreeImage.so.${pkgver}" "${pkgdir}/usr/lib/libFreeImage.so.3"
  ln -sf "libFreeImage.so.3" "${pkgdir}/usr/lib/libFreeImage.so"
  install -Dm644 Source/FreeImage.h "${pkgdir}/usr/include/FreeImage.h"
  install -Dm644 license-fi.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-fi"
  install -Dm644 license-gplv2.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-gplv2"
  install -Dm644 license-gplv3.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-gplv3"
}
